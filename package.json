{
  "name": "codex-pulse",
  "version": "1.5.4",
  "description": "A quiet desktop usage monitor for Codex.",
  "main": "main.js",
  "author": "Codex Pulse",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^38.1.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.codexpulse.desktop",
    "productName": "Codex Pulse",
    "icon": "assets/icon.ico",
    "files": [
      "main.js",
      "activity-bridge.js",
      "session-analytics.js",
      "preload.js",
      "usage-logic.js",
      "index.html",
      "styles.css",
      "renderer.js",
      "assets/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Codex-Pulse-${version}-${arch}-tray.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": false,
      "include": "build/installer.nsh",
      "createStartMenuShortcut": true,
      "artifactName": "Codex-Pulse-Setup.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "bonkval",
        "repo": "Codex-Pulse",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
